# For local HTTP only. Production defaults to Secure cookies.
BRIEFLEDGER_COOKIE_SECURE=false
BRIEFLEDGER_DATA_DIR=./data
# Set a bare public origin behind a reverse proxy if RENDER_EXTERNAL_URL is unavailable.
# BRIEFLEDGER_ORIGIN=https://your-host.example
# Disclosure only: set true when storage is not persistent across restarts.
BRIEFLEDGER_EPHEMERAL=false
PORT=8000
